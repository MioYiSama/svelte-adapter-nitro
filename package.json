{
  "name": "svelte-adapter-nitro",
  "version": "0.1.0",
  "description": "A SvelteKit adapter powered by Nitro.",
  "keywords": [
    "adapter",
    "deployment",
    "nitro",
    "svelte",
    "sveltekit"
  ],
  "homepage": "https://github.com/MioYiSama/svelte-adapter-nitro",
  "bugs": {
    "url": "https://github.com/MioYiSama/svelte-adapter-nitro/issues"
  },
  "license": "MIT",
  "author": "MioYiSama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MioYiSama/svelte-adapter-nitro.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@sveltejs/kit": "^3",
    "@types/node": "^26.6.5",
    "nitro": "^3.0.260903-beta",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=3",
    "nitro": "^3.0.260903-beta",
    "vite": ">=8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
