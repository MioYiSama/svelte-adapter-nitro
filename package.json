{
  "name": "svelte-adapter-nitro",
  "version": "0.0.6",
  "description": "A SvelteKit adapter powered by Nitro.",
  "keywords": [
    "adapter",
    "deployment",
    "nitro",
    "svelte",
    "sveltekit"
  ],
  "homepage": "https://github.com/MioYiSama/svelte-adapter-nitro",
  "bugs": {
    "url": "https://github.com/MioYiSama/svelte-adapter-nitro/issues"
  },
  "license": "MIT",
  "author": "MioYiSama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MioYiSama/svelte-adapter-nitro.git",
    "directory": "adapter"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "prepublishOnly": "vp pack"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.1",
    "@types/node": "^26.1.2",
    "nitro": "^3.0.260610-beta",
    "typescript": "6",
    "vite": "^8.1.5",
    "vite-plus": "latest"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2",
    "nitro": "^3.0.260610-beta",
    "vite": ">=8"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
